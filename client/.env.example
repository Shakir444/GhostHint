# Optional: add TURN credentials for better audio/video connectivity across restrictive networks.
# Use short-lived credentials from your TURN provider; VITE_* variables are bundled into the browser build.
VITE_TURN_URL=turn:your-turn-host.example:3478
VITE_TURN_USERNAME=replace-with-short-lived-username
VITE_TURN_CREDENTIAL=replace-with-short-lived-credential
